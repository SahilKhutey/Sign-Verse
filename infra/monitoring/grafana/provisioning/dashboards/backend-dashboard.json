{
    "dashboard": {
        "id": null,
        "title": "SignVerse Backend Metrics",
        "tags": [
            "signverse",
            "backend",
            "monitoring"
        ],
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "CPU Usage",
                "type": "graph",
                "datasource": "Prometheus",
                "targets": [
                    {
                        "expr": "rate(process_cpu_seconds_total{job=\"signverse-backend\"}[5m]) * 100",
                        "legendFormat": "{{instance}}",
                        "refId": "A"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Memory Usage",
                "type": "graph",
                "datasource": "Prometheus",
                "targets": [
                    {
                        "expr": "process_resident_memory_bytes{job=\"signverse-backend\"} / 1024 / 1024",
                        "legendFormat": "{{instance}}",
                        "refId": "A"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "HTTP Requests",
                "type": "graph",
                "datasource": "Prometheus",
                "targets": [
                    {
                        "expr": "rate(http_requests_total{job=\"signverse-backend\"}[5m])",
                        "legendFormat": "{{method}} {{status}}",
                        "refId": "A"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                }
            },
            {
                "id": 4,
                "title": "Request Duration",
                "type": "graph",
                "datasource": "Prometheus",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"signverse-backend\"}[5m]))",
                        "legendFormat": "p95",
                        "refId": "A"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                }
            }
        ],
        "time": {
            "from": "now-6h",
            "to": "now"
        }
    }
}