# SignVerse Production Environment Configuration

# Core Settings
ENV=production
DEBUG=false
SECRET_KEY=replace_this_with_a_secure_random_string_in_prod

# Service URLs (Internal Docker Network)
AI_ENGINE_URL=http://ai-engine:8000
BACKEND_URL=http://backend:8001
AVATAR_API_URL=http://avatar-api:8002
REDIS_URL=redis://redis:6379/0

# Database
DATABASE_URL=sqlite:///app/data/signverse.db

# Training Settings
TRAINING_THRESHOLD=50
WATCH_DIR=/app/datasets/user_feedback/pending_validation

# Hardware
USE_GPU=true
CUDA_VISIBLE_DEVICES=0

# Logging
LOG_LEVEL=INFO
